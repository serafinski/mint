# Copy this file to `.env` and fill in the values you actually use.
#
# Minimal local setup:
# - OPENAI_API_KEY
#
# Full evaluation / tracing setup:
# - OPENAI_API_KEY
# - LANGFUSE_PUBLIC_KEY
# - LANGFUSE_SECRET_KEY
# - LANGFUSE_HOST

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------

# Required for the default `openai:gpt-5-mini` model path used across the repo.
OPENAI_API_KEY=

# Optional model override. Defaults to `openai:gpt-5-mini` if unset.
LLM_MODEL=openai:gpt-5-mini

# ---------------------------------------------------------------------------
# LangFuse tracing (optional but strongly recommended for eval runs)
# ---------------------------------------------------------------------------

# Leave these blank if you do not want LangFuse tracing locally.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Local default from the repo docs. Change if your LangFuse instance lives elsewhere.
LANGFUSE_HOST=http://localhost:3000

# Compatibility alias used by some local/test paths. Keep it aligned with LANGFUSE_HOST.
LANGFUSE_BASE_URL=http://localhost:3000

# Optional. Tests force `test` internally before loading `.env`, so you usually do
# not need to set this yourself. For normal local runs, leaving it unset is fine.
# LANGFUSE_TRACING_ENVIRONMENT=default

# Optional test-only escape hatch. When true, tests strip LangFuse credentials and
# disable tracing entirely instead of routing traces to environment="test".
# LANGFUSE_DISABLE_DURING_TESTS=false

# ---------------------------------------------------------------------------
# Sandbox / verification tuning
# ---------------------------------------------------------------------------

# Optional Docker image override for sandboxed MCP_TOOL execution.
SANDBOX_IMAGE=jit-sandbox

# Optional adversarial probe reasoning level. Defaults to `low`.
# Typical values: minimal, low, medium, high.
JIT_ADVERSARIAL_REASONING=low
